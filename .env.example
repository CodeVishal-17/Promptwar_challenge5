# Optional model copy. Keys stay on the server and are never sent to the browser.
# With neither model key, the atelier writer still composes a full plan.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for POST /api/plan. The route returns 503 when either value is missing.
# Create a Redis database at https://console.upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared daily cap on plan creation for the whole deployment. This is the usage budget.
# The 8-request minute window is only a burst limit, not a spending cap.
PLAN_DAILY_LIMIT=100
